     void ShaderLibrary::setupMultisamplingShaders(RenderInterface *rhi, RenderDevice *device, const RenderMultisampling &multisampling) {
+        // Keep the working pipelines until all replacements are ready. A driver
+        // rejecting MSAA must not leave a running game with a partial shader library.
+        std::array<ShaderRecord *, 11> records = { &fbChangesDrawColor, &fbChangesDrawDepth,
+            &rtCopyDepthToColor, &rtCopyDepthToColorMS, &rtCopyColorToDepth, &rtCopyColorToDepthMS,
+            &postProcess, &debug, &rspVertexTestZ, &rspVertexTestZMS, &textureResolve };
+        std::array<ShaderRecord, 11> previous;
+        for (size_t i = 0; i < records.size(); i++) {
+            previous[i] = std::move(*records[i]);
+        }
+        try {
+            setupMultisamplingShadersImpl(rhi, device, multisampling);
+        }
+        catch (...) {
+            for (size_t i = 0; i < records.size(); i++) {
+                *records[i] = std::move(previous[i]);
+            }
+            throw;
+        }
+    }
