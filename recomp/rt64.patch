+    void RSP::setLightCBFD(uint32_t index, uint32_t address) {
+        if (index >= cbfd.lights.size()) {
+            return;
+        }
+
+        // Light layout (big-endian offsets): colour r,g,b at 0-2, direction x,y,z (s8) at 8-10,
+        // attenuation at 12, position x,y,z (s16) at 32-37.
+        const uint32_t rdramAddress = fromSegmentedMasked(address);
+        const uint8_t *data = state->fromRDRAM(rdramAddress);
+        auto byteAt = [&](uint32_t offset) { return data[offset ^ 3]; };
+        auto shortAt = [&](uint32_t offset) { return *reinterpret_cast<const int16_t *>(&data[offset ^ 2]); };
