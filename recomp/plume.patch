+#if defined(__ANDROID__)
+    // Moves the surface to the window Android shows now, if it changed. False while there's
+    // no window (the app is in the background) or the surface can't be made.
+    bool VulkanSwapChain::updateAndroidSurface() {
+        if (androidWindowProvider == nullptr) {
+            return surface != VK_NULL_HANDLE;
+        }
+
+        ANativeWindow *current = androidWindowProvider();
+        if (current == nullptr) {
+            return false;
+        }
+
+        if ((current == desc.renderWindow) && (surface != VK_NULL_HANDLE)) {
+            return true;
+        }
+
+        {
+            const std::scoped_lock queueLock(*commandQueue->queue->mutex);
+            vkQueueWaitIdle(commandQueue->queue->vk);
+        }
+
+        releaseImageViews();
+        releaseSwapChain();
+        VulkanInterface *renderInterface = commandQueue->device->renderInterface;
+        if (surface != VK_NULL_HANDLE) {
+            vkDestroySurfaceKHR(renderInterface->instance, surface, nullptr);
+            surface = VK_NULL_HANDLE;
+            ANativeWindow_release(desc.renderWindow);
+        }
+
+        desc.renderWindow = current;
+        VkAndroidSurfaceCreateInfoKHR surfaceCreateInfo = {};
+        surfaceCreateInfo.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+        surfaceCreateInfo.window = current;
+        VkResult res = vkCreateAndroidSurfaceKHR(renderInterface->instance, &surfaceCreateInfo, nullptr, &surface);
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreateAndroidSurfaceKHR failed with error code 0x%X.\n", res);
+            surface = VK_NULL_HANDLE;
+            return false;
+        }
+
+        ANativeWindow_acquire(current);
+
+        VkBool32 presentSupported = false;
+        vkGetPhysicalDeviceSurfaceSupportKHR(commandQueue->device->physicalDevice, commandQueue->familyIndex, surface, &presentSupported);
+        return presentSupported;
+    }
+#endif
