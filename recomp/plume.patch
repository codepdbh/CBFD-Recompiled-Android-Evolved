+            return false;
+        }
+        if (!androidDeviceLost.exchange(true)) {
+            char thread[32] = {};
+            pthread_getname_np(pthread_self(), thread, sizeof(thread));
+            fprintf(stderr, "The Vulkan device was lost (%s, thread %s).\n", where, thread);
+        }
+        return true;
+    }
